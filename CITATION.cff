title: DonationValues
message: "If you use this dataset, please cite the specific edition (DV-<taxyear>) and its DOI once minted."
type: dataset
authors:
  - name: DonationValues contributors
  - name: Foothill AI LLC
    website: https://foothill.ai
url: https://donationvalues.org
repository-code: https://github.com/donationvalues/donationvalues
