{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "name": "observations",
  "title": "DonationValues price observations",
  "description": "One row per observed price with full provenance. Prices enter the dataset only through this table, from a collector record or a partner-feed record. Rows are never deleted; problems are flagged in qa_flags and review_status.",
  "fields": [
    {"name": "obs_id", "type": "string", "format": "uuid", "constraints": {"required": true, "unique": true}},
    {"name": "dv_id", "type": "string", "description": "Mapped item spec", "constraints": {"required": true}},
    {"name": "mapping_confidence", "type": "number", "constraints": {"minimum": 0, "maximum": 1}},
    {"name": "mapped_by", "type": "string", "description": "'human' or an llm run id"},
    {"name": "source_kind", "type": "string", "constraints": {"required": true, "enum": ["in_store", "partner_feed", "online_sold"]}},
    {"name": "observed_at", "type": "date", "description": "Visit date or sold date", "constraints": {"required": true}},
    {"name": "store_chain", "type": "string", "constraints": {"required": true, "enum": ["goodwill", "savers", "salvation_army", "svdp", "independent", "consignment", "online_platform"]}},
    {"name": "store_format", "type": "string", "constraints": {"required": true, "enum": ["standard", "boutique", "outlet", "consignment", "online"]}},
    {"name": "store_id", "type": "string", "description": "Pseudonymous store id; resolves publicly to chain and metro only", "constraints": {"required": true}},
    {"name": "metro_cbsa", "type": "string", "description": "Core-based statistical area code"},
    {"name": "state", "type": "string", "constraints": {"pattern": "^[A-Z]{2}$"}},
    {"name": "census_division", "type": "string", "constraints": {"enum": ["new_england", "middle_atlantic", "east_north_central", "west_north_central", "south_atlantic", "east_south_central", "west_south_central", "mountain", "pacific"]}},
    {"name": "price_cents", "type": "integer", "description": "Full tag price, or sold price for online_sold", "constraints": {"required": true, "minimum": 1}},
    {"name": "markdown_status", "type": "string", "constraints": {"required": true, "enum": ["full_price", "color_tag_50", "color_tag_75", "other_discount"]}},
    {"name": "brand_raw", "type": "string", "description": "Brand as printed on the label or tag"},
    {"name": "brand_tier", "type": "string", "constraints": {"enum": ["basic", "mid", "premium"]}},
    {"name": "condition_flag", "type": "string", "description": "Items below 'good used condition' are never recorded", "constraints": {"required": true, "enum": ["good", "excellent"]}},
    {"name": "working_complete", "type": "boolean", "description": "Household goods and electronics only"},
    {"name": "size_class", "type": "string", "constraints": {"enum": ["adult_xs_s", "adult_m", "adult_l_xl", "adult_plus", "child", "n/a"]}},
    {"name": "material_class", "type": "string", "constraints": {"enum": ["cotton", "synthetic", "wool", "leather", "wood", "metal", "plastic", "glass_ceramic", "mixed", "n/a"]}},
    {"name": "substitute_flag", "type": "boolean", "description": "True when the closest-match substitution rule was applied", "constraints": {"required": true}},
    {"name": "platform", "type": "string", "description": "online_sold only"},
    {"name": "platform_fee_pct", "type": "number", "constraints": {"minimum": 0, "maximum": 100}},
    {"name": "shipping_cents", "type": "integer", "constraints": {"minimum": 0}},
    {"name": "collector_id", "type": "string", "description": "Pseudonymous contributor id (hash)", "constraints": {"required": true}},
    {"name": "certificate_version", "type": "string", "constraints": {"required": true}},
    {"name": "certified_at", "type": "datetime", "constraints": {"required": true}},
    {"name": "photo_hash", "type": "string", "description": "SHA-256 of the cropped tag photo held in private storage", "constraints": {"pattern": "^[a-f0-9]{64}$"}},
    {"name": "evidence_uri", "type": "string", "description": "Private evidence location; not public"},
    {"name": "qa_flags", "type": "string", "description": "Pipe-separated flags: outlier, duplicate, mismatch, impossible_date"},
    {"name": "review_status", "type": "string", "constraints": {"required": true, "enum": ["pending", "accepted", "rejected"]}},
    {"name": "reviewed_by", "type": "string"},
    {"name": "llm_run_ids", "type": "string", "description": "Pipe-separated ids of every model call that touched the row"}
  ],
  "primaryKey": ["obs_id"],
  "foreignKeys": [{"fields": ["dv_id"], "reference": {"resource": "items", "fields": ["dv_id"]}}],
  "missingValues": [""]
}
