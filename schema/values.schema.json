{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "name": "values",
  "title": "DonationValues derived values",
  "description": "Statistics computed by the pipeline from accepted observations under a named methodology version. Never hand-edited. One row per edition, item, region and tier.",
  "fields": [
    {"name": "edition", "type": "string", "constraints": {"required": true, "pattern": "^DV-[0-9]{4}(\\.[0-9]+)?$"}},
    {"name": "dv_id", "type": "string", "constraints": {"required": true}},
    {"name": "region", "type": "string", "description": "US or a Census division code", "constraints": {"required": true, "enum": ["US", "new_england", "middle_atlantic", "east_north_central", "west_north_central", "south_atlantic", "east_south_central", "west_south_central", "mountain", "pacific"]}},
    {"name": "tier", "type": "string", "description": "good_basic = p25, good = p50, excellent_premium = p75", "constraints": {"required": true, "enum": ["good_basic", "good", "excellent_premium"]}},
    {"name": "value_cents", "type": "integer", "description": "Published value after the rounding rule", "constraints": {"required": true, "minimum": 1}},
    {"name": "value_raw_cents", "type": "integer", "constraints": {"required": true, "minimum": 1}},
    {"name": "p10", "type": "integer"},
    {"name": "p25", "type": "integer"},
    {"name": "p50", "type": "integer"},
    {"name": "p75", "type": "integer"},
    {"name": "p90", "type": "integer"},
    {"name": "mode_cents", "type": "integer"},
    {"name": "n_obs", "type": "integer", "constraints": {"required": true, "minimum": 0}},
    {"name": "n_stores", "type": "integer", "constraints": {"required": true, "minimum": 0}},
    {"name": "n_metros", "type": "integer", "constraints": {"required": true, "minimum": 0}},
    {"name": "ci95_low", "type": "integer", "description": "Bootstrap percentile CI on the median, lower bound"},
    {"name": "ci95_high", "type": "integer"},
    {"name": "window_start", "type": "date", "constraints": {"required": true}},
    {"name": "window_end", "type": "date", "constraints": {"required": true}},
    {"name": "regional_index", "type": "number", "description": "Division median divided by national median; empty for US"},
    {"name": "inherited_from", "type": "string", "description": "Parent dv_id when minimum sample rules were not met"},
    {"name": "markdown_share", "type": "number", "constraints": {"minimum": 0, "maximum": 1}},
    {"name": "method_version", "type": "string", "constraints": {"required": true, "pattern": "^METHODOLOGY-[0-9]{4}\\.[0-9]+$"}},
    {"name": "observations_hash", "type": "string", "description": "SHA-256 over the sorted obs_ids that produced this row", "constraints": {"required": true, "pattern": "^[a-f0-9]{64}$"}},
    {"name": "change_reason", "type": "string", "constraints": {"enum": ["new", "new_sample", "taxonomy_change", "method_change", "correction"]}}
  ],
  "primaryKey": ["edition", "dv_id", "region", "tier"],
  "foreignKeys": [{"fields": ["dv_id"], "reference": {"resource": "items", "fields": ["dv_id"]}}],
  "missingValues": [""]
}
